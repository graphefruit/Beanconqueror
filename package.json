{
  "name": "beanconqueror",
  "version": "2.0.0",
  "author": "Lars Saalbach",
  "homepage": "https://github.com/graphefruit/beanconqueror",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --browsers=ChromeHeadless --watch=false",
    "test:coverage": "node --test tools/tests/coverage-cache-key.test.mjs && ng test --browsers=ChromeHeadless --watch=false --configuration=coverage",
    "test:dev": "ng test",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.html\" && stylelint \"src/**/*.scss\"",
    "e2e": "playwright test",
    "e2e:affected": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON e2e/tools/affected.ts",
    "test:e2e-tools": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"e2e/*.check.ts\" \"e2e/tools/*.check.ts\"",
    "e2e:perf": "playwright test --config playwright.perf.config.ts",
    "e2e:device": "playwright test --config playwright.device.config.ts",
    "e2e:device:build": "ng build --configuration production && cap sync android && cd android && ./gradlew assembleDebug",
    "e2e:device:build:release": "ng build --configuration production && cap sync android && cd android && ./gradlew assembleMeasure",
    "generate-test-data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON e2e/support/generate-test-data.ts",
    "prepare": "husky",
    "generate_proto": "protoc --plugin=node_modules/ts-proto/protoc-gen-ts_proto  --ts_proto_opt=snakeToCamel=false --ts_proto_opt=esModuleInterop=true --ts_proto_out ./src/generated ./src/classes/bean/bean.proto",
    "cap": "capacitor",
    "capsync": "capacitor sync android && capacitor sync ios",
    "live:android": "capacitor run android --live-reload --host localhost --port 4200 --forwardPorts 4200:4200",
    "live:ios": "capacitor run ios --live-reload --host localhost --port 4200",
    "generate-icon-registry": "node tools/generate-icon-registry.mjs > src/generated/icon-registry.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-browser-dynamic": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@awesome-cordova-plugins/android-permissions": "^9.7.0",
    "@awesome-cordova-plugins/core": "^9.7.0",
    "@bufbuild/protobuf": "^2.17.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/barcode-scanner": "^3.1.4",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/geolocation": "8.2.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/screen-reader": "8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.8",
    "@capawesome/capacitor-file-picker": "^8.1.1",
    "@capgo/camera-preview": "^8.15.4",
    "@capgo/capacitor-llm": "~8.0.19",
    "@ionic/angular": "^9.0.11",
    "@ionic/core": "^9.0.11",
    "@ionic/storage": "^4.0.0",
    "@ionic/storage-angular": "^4.0.0",
    "@mediapipe/tasks-genai": "^0.10.30",
    "@meticulous-home/espresso-api": "^0.10.12",
    "@meticulous-home/espresso-profile": "^0.4.2",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@pantrist/capacitor-plugin-ml-kit-text-recognition": "^8.1.1",
    "@tanstack/angular-virtual": "6.1.12",
    "@zip.js/zip.js": "~2.25.0",
    "ble-central-advertisements": "^1.1.0",
    "chart.js": "~4.6.1",
    "community-cordova-plugin-nfc": "^1.9.0",
    "currency-symbol-map": "^5.1.0",
    "html-to-image": "^1.11.13",
    "ionicons": "^8.1.0",
    "javascript-color-gradient": "^2.5.0",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "ngx-stars": "^1.6.5",
    "qrcode": "^1.5.4",
    "regression": "^2.0.1",
    "rxjs": "^7.8.2",
    "safe-stable-stringify": "^2.5.0",
    "serialize-error": "^13.1.0",
    "swiper": "^12.2.0",
    "tslib": "^2.9.1",
    "uplot": "1.6.32",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/schematics": "^22.3.0",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/language-service": "^22.3.0",
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@ionic/angular-toolkit": "^13.0.0",
    "@playwright/test": "^1.65.1",
    "@types/jasmine": "^5.1.15",
    "@types/lodash": "^4.17.27",
    "@types/node": "^25.9.9",
    "angular-eslint": "^22.8.0",
    "cordova-plugin-android-permissions": "^1.1.5",
    "cordova-plugin-ble-central": "2.0.0",
    "cordova-plugin-health": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^5.13.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "lint-staged": "^16.4.0",
    "postcss-scss": "4.0.9",
    "prettier": "^3.10.1",
    "skwas-cordova-plugin-datetimepicker": "^3.0.2",
    "stylelint": "18.0.0",
    "ts-proto": "^2.22.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.2"
  },
  "description": "Beanconqueror",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=10.26.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "platforms": [
    "android",
    "ios"
  ],
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "<BUILTIN_MODULES>",
      "",
      "^@angular",
      "",
      "^@ionic",
      "^ionicons",
      "",
      "<THIRD_PARTY_MODULES>",
      "",
      "^src/",
      "^[.]"
    ],
    "importOrderParserPlugins": [
      "typescript",
      "decorators"
    ]
  },
  "lint-staged": {
    "*.{ts,js,css,md}": "prettier --write"
  }
}
